rules_version = '2';

// Akflix accounts (Firebase Spark plan).
//
// * Everything a person syncs lives under /users/{their uid}: profiles,
//   titles (Continue Watching position, watched state, My List, rating) and
//   settings. Only that signed-in person can read or write it.
// * /deviceLinks/{code} carries the TV sign-in handshake: a Roku that is not
//   signed in registers a short-lived waiting code, a signed-in iPhone or Mac
//   approves it, and the TV reads it once and deletes it.
// * Anything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /users/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /deviceLinks/{code} {
      // 8 characters from an alphabet without vowels, 0/O or 1/I.
      function validCode() {
        return code.matches('^[BCDFGHJKLMNPQRSTVWXZ2-9]{8}$');
      }

      allow create: if validCode()
        && request.resource.data.keys().hasOnly(['status', 'deviceName', 'platform', 'expiresAt'])
        && request.resource.data.status == 'waiting'
        && request.resource.data.deviceName is string
        && request.resource.data.deviceName.size() > 0
        && request.resource.data.deviceName.size() <= 60
        && request.resource.data.platform is string
        && request.resource.data.platform.size() <= 20
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(15, 'm');

      // Reading needs the exact code; codes can never be listed.
      allow get: if validCode();
      allow list: if false;

      allow update: if signedIn()
        && resource.data.status == 'waiting'
        && resource.data.expiresAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'uid', 'email', 'refreshToken', 'approvedBy'])
        && request.resource.data.status == 'approved'
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.refreshToken is string
        && request.resource.data.refreshToken.size() > 0
        && request.resource.data.refreshToken.size() < 4096;

      allow delete: if (signedIn() && resource.data.get('uid', '') == request.auth.uid)
        || resource.data.expiresAt < request.time;
    }
  }
}
